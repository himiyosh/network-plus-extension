{
  "name": "network-plus-extension",
  "version": "1.5.0",
  "description": "Enhanced Network panel extension for Microsoft Edge DevTools with filtering, export, theme, sorting, and advanced filters.",
  "main": "devtools.js",
  "scripts": {
    "test": "jest --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write package.json eslint.config.mjs .prettierrc \"scripts/**/*.js\" \"tests/repository-integrity.test.js\" \"tests/text-integrity.test.js\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check package.json eslint.config.mjs .prettierrc \"scripts/**/*.js\" \"tests/repository-integrity.test.js\" \"tests/text-integrity.test.js\" \".github/**/*.{yml,yaml}\"",
    "version:check": "node scripts/check-version-sync.js",
    "integrity:check": "node scripts/check-repository-integrity.js",
    "text:check": "node scripts/check-text-integrity.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
