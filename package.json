{
  "name": "network-plus-extension",
  "version": "1.6.0",
  "description": "Network analysis with sanitized HAR, retention limits, integrated search, accessible UI, and keyboard controls.",
  "private": true,
  "main": "devtools.js",
  "scripts": {
    "test": "jest --coverage",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write package.json eslint.config.mjs .prettierrc \"scripts/**/*.js\" \"tests/extension-package.test.js\" \"tests/repository-integrity.test.js\" \"tests/store-readiness.test.js\" \"tests/support-intake.test.js\" \"tests/text-integrity.test.js\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check package.json eslint.config.mjs .prettierrc \"scripts/**/*.js\" \"tests/extension-package.test.js\" \"tests/repository-integrity.test.js\" \"tests/store-readiness.test.js\" \"tests/support-intake.test.js\" \"tests/text-integrity.test.js\" \".github/**/*.{yml,yaml}\"",
    "version:check": "node scripts/check-version-sync.js",
    "integrity:check": "node scripts/check-repository-integrity.js",
    "text:check": "node scripts/check-text-integrity.js",
    "extension:check": "node scripts/check-extension-package.js --check",
    "extension:package": "node scripts/check-extension-package.js --package",
    "store:check": "node scripts/check-store-readiness.js",
    "audit:strict": "npm audit --audit-level=high",
    "contract:check": "node scripts/check-coordinator-contract.js"
  },
  "keywords": [
    "network debugging",
    "developer tools",
    "HTTP inspector",
    "HAR export",
    "request filtering",
    "response timing",
    "Edge DevTools"
  ],
  "author": "himiyosh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himiyosh/network-plus-extension.git"
  },
  "homepage": "https://github.com/himiyosh/network-plus-extension",
  "bugs": {
    "url": "https://github.com/himiyosh/network-plus-extension/issues/new/choose"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^5.2.2"
    }
  }
}
