{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import pathlib,runpy,subprocess,sys; root=subprocess.run(['git','rev-parse','--show-toplevel'],check=True,capture_output=True,text=True).stdout.rstrip('\\r\\n'); p=pathlib.Path(root)/'.codex/hooks/codex_harness.py'; sys.argv=[str(p),'hook']; runpy.run_path(str(p),run_name='__main__')\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import pathlib,runpy,subprocess,sys; root=subprocess.run(['git','rev-parse','--show-toplevel'],check=True,capture_output=True,text=True).stdout.rstrip('\\r\\n'); p=pathlib.Path(root)/'.codex/hooks/codex_harness.py'; sys.argv=[str(p),'hook']; runpy.run_path(str(p),run_name='__main__')\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import pathlib,runpy,subprocess,sys; root=subprocess.run(['git','rev-parse','--show-toplevel'],check=True,capture_output=True,text=True).stdout.rstrip('\\r\\n'); p=pathlib.Path(root)/'.codex/hooks/codex_harness.py'; sys.argv=[str(p),'hook']; runpy.run_path(str(p),run_name='__main__')\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
